{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_readme": "gatecrate TypeScript adapter — copy to stryker.config.json. run-mutation.sh runs `npx stryker run`. IMPORTANT: @stryker-mutator/* must match your Vitest major (Vitest 3/4 need @stryker-mutator >=9; 8.x crashes on Vitest 4). After install, run `sh scripts/run-mutation.sh` once and confirm it prints a score (a gate that never runs gives false assurance).",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/main.tsx",
    "!src/**/*test-helpers.ts",
    "!src/**/*fixtures.ts"
  ],
  "thresholds": { "high": 90, "low": 80, "break": 80 },
  "coverageAnalysis": "perTest"
}
